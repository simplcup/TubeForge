<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="20dp"
    android:paddingEnd="18dp"
    android:tag="bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/queue"
            android:textSize="27sp"
            android:textStyle="bold"
            android:tag="title" />

        <TextView
            android:id="@+id/q_clear"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_ghost"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/clear_finished"
            android:textSize="12sp"
            android:textStyle="bold"
            android:tag="ghostButton" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Downloads run one at a time. Queue up as many as you like."
        android:textSize="12.5sp"
        android:tag="muted" />

    <TextView
        android:id="@+id/q_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textSize="11.5sp"
        android:tag="dim" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/q_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/q_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Nothing queued yet.\nDownloads you start appear here."
        android:textSize="13sp"
        android:tag="dim" />
</LinearLayout>
